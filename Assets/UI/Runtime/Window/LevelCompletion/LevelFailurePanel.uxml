<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" authoring-id="1817163689">
    <ui:Template name="SceneButtons" src="project://database/Assets/UI/Runtime/Window/LevelCompletion/SceneButtons.uxml?fileID=9197481963319205126&amp;guid=6c72c604ccda23a4a92c0ae9212f3827&amp;type=3#SceneButtons"/>
    <Style src="project://database/Assets/UI/Runtime/Window/WindowPanel.uss?fileID=7433441132597879392&amp;guid=76db545b18f25e3498be9687b86c6f26&amp;type=3#WindowPanel"/>
