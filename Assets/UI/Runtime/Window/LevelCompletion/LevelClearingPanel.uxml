<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" authoring-id="1817163689">
    <ui:Template name="SceneButtons" src="project://database/Assets/UI/Runtime/Window/LevelCompletion/SceneButtons.uxml?fileID=9197481963319205126&amp;guid=6c72c604ccda23a4a92c0ae9212f3827&amp;type=3#SceneButtons"/>
    <Style src="project://database/Assets/UI/Runtime/Window/WindowPanel.uss?fileID=7433441132597879392&amp;guid=76db545b18f25e3498be9687b86c6f26&amp;type=3#WindowPanel"/>
    <Style src="project://database/Assets/UI/Runtime/Window/LevelCompletion/LevelClearingPanel.uss?fileID=7433441132597879392&amp;guid=8723c5999c7d137439d9282abfc557a0&amp;type=3#LevelClearingPanel"/>
    <ui:VisualElement name="window-overlay" class="window-overlay">
        <ui:VisualElement name="window-panel" class="window-panel">
            <ui:VisualElement name="window-header" class="window-header">
                <ui:Label text="1-1" name="level-index-label" authoring-id="1005501063" class="level-index-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="window-body" class="window-body">
                <ui:Label text="LEVEL CLEARED!" name="level-cleared-label" class="level-cleared-label"/>
                <ui:VisualElement name="stats-row" class="stats-row">
                    <ui:VisualElement name="score-column" class="stats-column">
                        <ui:Label text="SCORE: 12345" name="final-score-label" authoring-id="759723847" class="stats-title-label"/>
                        <ui:VisualElement name="rating-container" authoring-id="-942655800" class="rating-container">
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="record-column" class="stats-column">
                        <ui:Label text="RECORD SCORE:" name="record-title" class="stats-title-label record-title-label"/>
                        <ui:VisualElement name="record-rating-container" authoring-id="-941732279" class="rating-container record-rating-container">
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Instance template="SceneButtons" authoring-id="2077141045"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
