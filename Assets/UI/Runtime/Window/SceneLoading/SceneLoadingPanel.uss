.screen-overlay {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(49, 55, 66, 0.698);
    font-size: 110px;
    color: rgb(255, 255, 255);
    align-content: center;
    row-gap: 175px;
}

.loading-progress-bar {
    width: 400px;
    height: auto;
}

.loading-progress-bar .unity-progress-bar__container {
    height: auto;
    min-height: 30px;
}

.loading-progress-bar .unity-progress-bar__background {
    border-top-color: rgb(228, 37, 85);
    border-right-color: rgb(228, 37, 85);
    border-bottom-color: rgb(228, 37, 85);
    border-left-color: rgb(228, 37, 85);
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    height: 100px;
}

.loading-progress-bar .unity-progress-bar__progress {
    background-color: rgb(228, 37, 85);
}
