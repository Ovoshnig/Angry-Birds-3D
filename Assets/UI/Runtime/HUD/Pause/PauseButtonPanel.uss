.pause-button {
    top: 8px;
    left: 8px;
    background-image: url("project://database/Assets/Art/Sprites/UI/png@3x/Buttons/Square-Medium/Pause/Default@3x.png?fileID=2800000&guid=27810ab3fdddb764e949ffb81eeb33e3&type=3#Default@3x");
