.clearing-overlay {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.clearing-panel {
    width: 1140px;
    background-color: rgba(21, 26, 35, 0.94);
    border-radius: 28px;
    overflow: hidden;
    font-size: 65px;
    color: rgb(255, 255, 255);
}

.clearing-header {
    background-color: rgba(11, 14, 20, 0.96);
    padding: 16px 48px;
}

.level-index-label {
    font-size: 92px;
    -unity-text-align: middle-left;
}

.clearing-body {
    padding: 36px 48px 44px 48px;
}

.level-cleared-label {
    font-size: 74px;
    -unity-text-align: middle-left;
    margin-bottom: 34px;
}

.stats-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 44px;
}

.stats-column {
    align-items: flex-start;
}

.stats-title-label {
    font-size: 60px;
    -unity-text-align: middle-left;
    margin-bottom: 24px;
}

.record-title-label {
}

.rating-container {
    width: 340px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.record-rating-container {
    opacity: 0;
}

.star {
    width: 92px;
    height: 92px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Art/Sprites/UI/png@3x/Star/Large/Active@3x.png?fileID=2800000&guid=b41b032ec6818e24a924373460726382&type=3#Active@3x");
}

.buttons-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.nav-button {
    width: 175px;
    height: 175px;
    margin: 0 38px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.1s;
}

.nav-button:enabled:hover {
    scale: 1.06;
}

.nav-button:enabled:active {
    scale: 0.95;
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.nav-button:disabled {
    opacity: 0.4;
}
