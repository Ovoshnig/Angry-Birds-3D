<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" authoring-id="1817163689">
    <Style src="project://database/Assets/UI/Runtime/HUD/LevelClearing/LevelClearingHUD.uss?fileID=7433441132597879392&amp;guid=8723c5999c7d137439d9282abfc557a0&amp;type=3#LevelClearingHUD"/>
    <ui:VisualElement name="clearing-overlay" class="clearing-overlay">
        <ui:VisualElement name="clearing-panel" class="clearing-panel">
            <ui:VisualElement name="clearing-header" class="clearing-header">
                <ui:Label text="1-1" name="level-index-label" authoring-id="1005501063" class="level-index-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="clearing-body" class="clearing-body">
                <ui:Label text="LEVEL CLEARED!" name="level-cleared-label" class="level-cleared-label"/>
                <ui:VisualElement name="stats-row" class="stats-row">
                    <ui:VisualElement name="score-column" class="stats-column">
                        <ui:Label text="SCORE: 12345" name="final-score-label" authoring-id="759723847" class="stats-title-label"/>
                        <ui:VisualElement name="rating-container" authoring-id="-942655800" class="rating-container">
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="record-column" class="stats-column">
                        <ui:Label text="RECORD SCORE:" name="record-title" class="stats-title-label record-title-label"/>
                        <ui:VisualElement name="record-rating-container" authoring-id="-941732279" class="rating-container record-rating-container">
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                            <ui:VisualElement class="star"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="buttons-container" authoring-id="-695955032" class="buttons-container">
                    <Ovoshnig.Scene.Switching.SceneSwitchButton name="levels-button" class="nav-button" style="background-image: url(&quot;project://database/Assets/Art/Sprites/UI/png@3x/Buttons/Square-Medium/Levels/Default@3x.png?fileID=2800000&amp;guid=0346b8645a584d343ae3d6ca75225e14&amp;type=3#Default@3x&quot;);"/>
                    <Ovoshnig.Scene.Switching.SceneSwitchButton name="repeat-button" navigation-type="CurrentLevel" class="nav-button" style="background-image: url(&quot;project://database/Assets/Art/Sprites/UI/png@3x/Buttons/Square-Medium/Repeat/Default@3x.png?fileID=2800000&amp;guid=5345b4d167c7fd846a8036f31f910f49&amp;type=3#Default@3x&quot;);"/>
                    <Ovoshnig.Scene.Switching.SceneSwitchButton name="next-button" navigation-type="NextLevel" class="nav-button" style="background-image: url(&quot;project://database/Assets/Art/Sprites/UI/png@3x/Buttons/Square-Medium/Play/Default@3x.png?fileID=2800000&amp;guid=f239f111b1cfb8d48a8a00edad45560b&amp;type=3#Default@3x&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
